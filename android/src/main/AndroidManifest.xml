<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required to acquire a WifiManager.MulticastLock so inbound mDNS
         multicast reaches our sockets; without it Android filters those packets
         and LAN-only p2p discovery silently fails. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- From Android 17 (API 37) local network access is gated behind this
         runtime permission; denied, every LAN socket fails and peer discovery
         dies with no error. Below API 37 it is granted implicitly. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

</manifest>
